# ─── Jarvis AI Assistant — example environment ────────────────────────────────
# Copy this file to `.env` and adjust as needed. NEVER commit your real .env.
# Every value below is optional; the defaults in config.py are used if unset.

# ── LLM provider ──────────────────────────────────────────────────────────────
# "ollama" (default, local, no key) or "openai_compatible" (any cloud endpoint).
LLM_PROVIDER=ollama
# Only used when LLM_PROVIDER=openai_compatible:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-key-here
# LLM_MODEL=gpt-4o-mini

# ── LLM (Ollama) ──────────────────────────────────────────────────────────────
# The Ollama model used for reasoning and tool calling.
OLLAMA_MODEL=llama3.2
# Ollama's OpenAI-compatible endpoint. Change the host/port if Ollama is remote.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Sampling temperature (0.0 = deterministic, 1.0 = creative).
OLLAMA_TEMPERATURE=0.5
# Max tokens in a single reply (kept low for snappy speech).
OLLAMA_MAX_TOKENS=256
# CPU threads Ollama may use for generation.
OLLAMA_NUM_THREADS=6

# ── Web app ───────────────────────────────────────────────────────────────────
# The server binds to loopback only — do NOT change to 0.0.0.0.
WEB_HOST=127.0.0.1
WEB_PORT=8765

# ── File workspace ────────────────────────────────────────────────────────────
# Sandbox the file tools and uploads are confined to.
# WORKSPACE_DIR=workspace
MAX_UPLOAD_BYTES=20971520
MAX_FILE_READ_CHARS=20000

# ── Web access (fetch + search tools) ─────────────────────────────────────────
FETCH_MAX_CHARS=6000
WEB_SEARCH_MAX_RESULTS=5
MAX_FETCHES_PER_TURN=3
HTTP_TIMEOUT=15

# ── Agent loop ────────────────────────────────────────────────────────────────
# Max tool-calling rounds per turn before Jarvis must answer.
MAX_TOOL_ROUNDS=5

# ── Safety ────────────────────────────────────────────────────────────────────
# Set to "true" to enable tools that run shell commands and drive the keyboard
# (run_system_command, type_text, press_key). Leave false unless you understand
# the risk — these let the model execute arbitrary actions on your machine.
ALLOW_DANGEROUS_TOOLS=false

# ── Memory ────────────────────────────────────────────────────────────────────
# Path to the SQLite database. Defaults to ./jarvis_memory.db.
# DATABASE_PATH=jarvis_memory.db
# Number of recent messages replayed to the model each turn.
CONTEXT_WINDOW=10

# ── Voice / Audio ─────────────────────────────────────────────────────────────
# edge-tts voice (see: edge-tts --list-voices).
TTS_VOICE=en-US-GuyNeural
# Speech rate adjustment.
TTS_RATE=+10%
# Seconds to wait for speech before giving up.
LISTEN_TIMEOUT=8
# Max seconds captured per utterance.
LISTEN_PHRASE_LIMIT=15
# Microphone energy threshold (raise in noisy rooms).
ENERGY_THRESHOLD=300
